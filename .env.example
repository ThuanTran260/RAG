# Copy this file to .env and fill in real values. Never commit .env.

# LLM provider (Gemini, Groq, ...) behind the LLMClient abstraction
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=gemini-3.5-flash-lite

# Qdrant (docker compose service: qdrant)
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=labor_law_vn

# Embedding and reranker models
EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# Optional embedding settings. Leave EMBEDDING_DEVICE unset to use the GPU when one is available.
# EMBEDDING_DEVICE=cpu
# EMBEDDING_BATCH_SIZE=16

# search/ask mode: dense, sparse or hybrid. Sparse and hybrid need: uv run python -m ingestion.index --hybrid
# RETRIEVAL_MODE=dense
# Put chunks of the articles a question names first; must be false when RETRIEVAL_MODE=sparse.
# ARTICLE_PROMOTION=true
